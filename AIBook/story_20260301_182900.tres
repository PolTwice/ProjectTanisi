creeLines = Array[String](["Charlie iskwêwâk wîkîhkâk! Nîsta, wîkîhkâk, nîkâwîk kîkway nîhîhkâk.", "Nîkâwîk pîsimwâk kîkway. 'Nîs!' Charlie pîkiskwêw, kîkway kîkâk.", "Nîkâwîk nîkâwîk pîsimwâk. 'Nîs!' nîkâwîk kîkway, kîkway kîkâk.", "Nîkâwîk nîkâwîk pîsimwâk. 'Nîs!' Charlie pîkiskwêw, kîkway kîkâk.", "Nîkâwîk Charlie nîkâwîk kîkway. 'Nîs!' nîkâwîk kîkway, kîkway kîkâk."])
englishLines = Array[String](["Charlie the Chipmunk woke up excited! Today, he wanted to count everything he saw.", "One big tree stood tall. 'One!' Charlie shouted, pointing at it.", "He spotted two fluffy clouds. 'Two!' he giggled, waving at them.", "Next, three bright flowers bloomed. 'Three!' Charlie cheered, dancing around.", "At last, Charlie found four shiny pebbles. 'Four!' he laughed, feeling happy."])
